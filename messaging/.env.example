# Your own CrypterChat chat server
MESSAGING_HOST=0.0.0.0
MESSAGING_PORT=8787
SERVER_NAME=My CrypterChat Server
# Optional: the URL friends should paste into the CrypterChat app
# PUBLIC_URL=https://chat.example.com

# Where encrypted envelopes + phone sessions are stored (on YOUR machine)
MESSAGING_DATA_DIR=./data

# Shared ChatScan X11 chain (hashes only — not your chat content)
# Point this at a public explorer, or run ChatScan yourself.
CHATSCAN_URL=http://127.0.0.1:3000
# CHATSCAN_INGEST_KEY=

# Local/demo phone OTP (replace with real SMS in production)
DEMO_OTP=123456
APP_VERSION=crypterchat-1.0
